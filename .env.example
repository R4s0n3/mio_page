# Database
DATABASE_URL=mysql://user:password@localhost:3306/mio_page

# Stripe Checkout, invoices, and payment reconciliation
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for /api/stripe/webhook (not an API key)
STRIPE_WEBHOOK_SECRET=whsec_...

# Sponsor logo uploads (cdn-api). CDN_URL is the origin only, with no path.
# CDN_API_KEY is sent as the X-API-Key header.
CDN_URL=https://cdn.miomideal.com
CDN_API_KEY=replace-me
# Legacy fallback, used only when CDN_URL or CDN_API_KEY is unset.
# UPLOAD_URL is the upload prefix; the site appends "single".
# Example for this CDN: https://cdn.miomideal.com/api/upload/
# UPLOAD_URL=https://cdn.example.com/upload/
# UPLOAD_KEY=replace-me

# Order email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=orders@example.com
SMTP_PASSWORD=change-me
SMTP_SECURE=false
ORDER_EMAIL_FROM=orders@example.com
ORDER_STATUS_LINK_SECRET=replace-with-at-least-32-random-characters

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
